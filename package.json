    "@types/react-dom": "^19.2.2",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.2.6",
    "tsx": "^4.22.3",
    "typescript": "5.8.3"
  },
  "description": "Open-source Next.js reference app for the Grizzly Bulls Aircraft Intelligence API",
  "repository": {
    "type": "git",
